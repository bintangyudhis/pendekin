# Contoh konfigurasi environment untuk development lokal.
# Salin menjadi .env lalu isi nilainya. JANGAN commit file .env asli.
#
# Produksi memakai Supabase Postgres (project "streak-apps", region Singapore):
# - DATABASE_URL = connection pooler transaksi (port 6543) + ?pgbouncer=true
# - DIRECT_URL   = connection pooler session (port 5432), dipakai saat migrasi
# Direct connection db.<ref>.supabase.co:5432 TIDAK reachable — jangan dipakai.

DATABASE_URL="postgresql://postgres:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
